{
  "name": "agent-xray",
  "version": "1.12.0",
  "description": "Web dashboard for viewing AI agent session logs — supports OpenClaw, Codex, Claude Code, and Hermes",
  "main": "server.js",
  "bin": {
    "agentxray": "bin/agentxray.js",
    "agent-xray": "bin/agentxray.js"
  },
  "files": [
    "server.js",
    "lib",
    "public",
    "bin",
    "README.md",
    "frontend/dist"
  ],
  "scripts": {
    "start": "node server.js",
    "build:ui": "cd frontend && npm run build",
    "build:ui:full": "cd frontend && npm ci && npm run build",
    "prepare": "node -e \"process.exit(require('fs').existsSync('frontend/dist/index.html') ? 0 : 1)\" || npm run build:ui:full",
    "test": "node --test test/*.test.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "node -e \"if (!require('fs').existsSync('frontend/dist/index.html')) { console.error('frontend/dist missing — run npm run build:ui:full'); process.exit(1); }\""
  },
  "keywords": [
    "agent",
    "logs",
    "viewer",
    "claude-code",
    "codex",
    "openclaw",
    "hermes",
    "jsonl",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.2",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}