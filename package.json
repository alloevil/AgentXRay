{
  "name": "@alloevil/agent-xray",
  "version": "1.15.0",
  "description": "Web dashboard for viewing AI agent session logs — supports OpenClaw, Codex, Claude Code, Hermes, OMP, DeepSeek Harness, and Gemini CLI",
  "main": "server.js",
  "bin": {
    "agentxray": "bin/agentxray.js",
    "agent-xray": "bin/agentxray.js"
  },
  "files": [
    "server.js",
    "lib",
    "public",
    "bin",
    "README.md",
    "frontend/dist"
  ],
  "scripts": {
    "start": "node server.js",
    "build:ui": "node scripts/build-legacy-pure.mjs && cd frontend && npm run build",
    "build:ui:full": "cd frontend && npm ci && cd .. && npm run build:ui",
    "prepare": "node -e \"process.exit(require('fs').existsSync('frontend/dist/index.html') ? 0 : 1)\" || npm run build:ui:full",
    "test": "node --test test/*.test.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "node -e \"if (!require('fs').existsSync('frontend/dist/index.html')) { console.error('frontend/dist missing — run npm run build:ui:full'); process.exit(1); }\"",
    "build:legacy-pure": "node scripts/build-legacy-pure.mjs"
  },
  "keywords": [
    "agent",
    "logs",
    "viewer",
    "claude-code",
    "codex",
    "openclaw",
    "hermes",
    "deepseek",
    "deepseek-harness",
    "gemini",
    "gemini-cli",
    "jsonl",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alloevil/AgentXRay.git"
  },
  "homepage": "https://github.com/alloevil/AgentXRay#readme",
  "bugs": {
    "url": "https://github.com/alloevil/AgentXRay/issues"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.2",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}
